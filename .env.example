# ============================================================
# 复制为 .env 后填写（.env 已被 .gitignore 忽略，禁止提交）
# ============================================================

# ---------- 应用 ----------
APP_NAME=fin-news-v5
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# ---------- 数据库（docker-compose 默认端口 5433） ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=finnews
POSTGRES_PASSWORD=finnews
POSTGRES_DB=finnews
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---------- Tushare ----------
TUSHARE_TOKEN=your_tushare_token_here
TUSHARE_TIMEOUT=30
TUSHARE_QPS=3.0

# 资讯源（news 接口的 src 参数；需单独开通资讯权限）
NEWS_SOURCES=["cls","wallstreetcn"]

# ---------- 接入调度 ----------
INGEST_INTERVAL_SECONDS=60
INGEST_OVERLAP_SECONDS=300
INGEST_FIRST_LOOKBACK_HOURS=6

# ---------- 评分 ----------
SCORING_BATCH_SIZE=30
SCORING_WINDOW_SECONDS=15
SCORING_MAX_CONTENT_CHARS=800
SCORING_CONCURRENCY=4
SCORE_THRESHOLD_VECTORIZE=3

# ---------- Embedding ----------
EMBEDDING_PROVIDER=volcengine
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ---------- LLM（OpenAI 兼容接口，火山引擎 / DeepSeek 自由切换） ----------
LLM_DEFAULT_PROVIDER=volcengine
LLM_FALLBACK_PROVIDER=deepseek
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_API_KEY=
VOLCENGINE_MODEL_SCORING=doubao-lite-32k
VOLCENGINE_MODEL_ANALYSIS=doubao-pro-32k
VOLCENGINE_MODEL_QA=doubao-pro-32k
VOLCENGINE_MODEL_EMBEDDING=doubao-embedding

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_SCORING=deepseek-chat
DEEPSEEK_MODEL_ANALYSIS=deepseek-chat
DEEPSEEK_MODEL_QA=deepseek-chat

# ---------- Agent ----------
USE_DEEP_AGENTS=true
ANALYSIS_CONCURRENCY=4
ANALYSIS_TIMEOUT_SECONDS=300

# 宏观政策 Agent 的外部信息检索（Tavily，未配置则降级，仅用历史检索）
WEB_SEARCH_ENABLED=false
# 留空时回退到 TAVILY_API_KEY 环境变量
WEB_SEARCH_API_KEY=
# 自建网关 / 代理才需要填，留空走 https://api.tavily.com
WEB_SEARCH_BASE_URL=
WEB_SEARCH_TOPIC=news
WEB_SEARCH_DEPTH=basic
WEB_SEARCH_TIME_RANGE=week
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_LANGUAGE=zh-cn
WEB_SEARCH_TIMEOUT_SECONDS=30
WEB_SEARCH_INCLUDE_DOMAINS=
WEB_SEARCH_EXCLUDE_DOMAINS=

# ---------- Pipeline ----------
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_LIMIT=50
EVENT_MAX_ATTEMPTS=5
EVENT_BACKOFF_BASE_SECONDS=30
EVENT_RETENTION_DAYS=7

# ---------- 盘前 / 盘后 ----------
PRE_MARKET_HOUR=7
PRE_MARKET_MINUTE=30
POST_MARKET_HOUR=15
POST_MARKET_MINUTE=30

# ---------- 追问 ----------
CHAT_TOP_K=8
CHAT_RECENT_DAYS=7

# ---------- API ----------
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]
